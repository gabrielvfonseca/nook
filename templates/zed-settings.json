{
  "replica": {
    "description": "APFS clonefile workspace manager for agent workloads",
    "commands": {
      "new": "replica new [--ttl 2h] [--name label]",
      "env": "replica env <id>",
      "list": "replica list",
      "gc": "replica gc",
      "stats": "replica stats"
    },
    "env": {
      "REPLICA_ROOT": "/Volumes/Work/replica"
    },
    "workflow": "cd $(replica new) && zed .",
    "more_info": "https://github.com/gabrielfonseca/replica"
  }
}