<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.replica.gc</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPLICA_BIN__</string>
    <string>gc</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REPLICA_ROOT</key><string>__REPLICA_ROOT__</string>
  </dict>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/tmp/replica-gc.log</string>
  <key>StandardOutPath</key><string>/tmp/replica-gc.log</string>
</dict>
</plist>
